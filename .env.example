# ElevenLabs API Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Voice Mapping (Dynamically Discovered)
# Any environment variable starting with VOICE_ will be registered as a voice
# The voice name is derived from the variable name (e.g., VOICE_SARAH -> "sarah")
# Get voice IDs from https://elevenlabs.io/voice-lab
#
# Example: Create a custom voice called "sarah"
# VOICE_SARAH=your_elevenlabs_voice_id_here
#
# Example: Add multiple custom voices
# VOICE_ALICE=another_voice_id_here
# VOICE_JOHN=yet_another_voice_id
#
# Hot-reload: Changes are picked up automatically without server restart!

# Default Voice ID (if no VOICE_* variable matches)
# ELEVENLABS_DEFAULT_VOICE_ID=your_default_voice_id_here
